{
  "manifest_version": 3,
  "name": "better-riftdecks",
  "version": "0.4.1",
  "description": "Block common ads and trackers, hide visual decklists, and restore new-tab shortcuts on deck sites.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://riftdecks.com/*",
    "*://*.riftdecks.com/*",
    "*://mtgdecks.net/*",
    "*://*.mtgdecks.net/*",
    "*://inkdecks.com/*",
    "*://*.inkdecks.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://riftdecks.com/*",
        "*://*.riftdecks.com/*",
        "*://mtgdecks.net/*",
        "*://*.mtgdecks.net/*",
        "*://inkdecks.com/*",
        "*://*.inkdecks.com/*"
      ],
      "css": [
        "clean.css"
      ],
      "run_at": "document_start",
      "js": [
        "adaptive-ads.js",
        "hide-visual-decklist.js",
        "link-shortcuts.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_networks",
        "enabled": true,
        "path": "rules/ad-networks.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better-riftdecks@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
